<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>jp.wamei.notes-sync</string>
  <key>ProgramArguments</key>
  <array><string>@HOME@/.local/bin/notes-sync</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <!-- メモ.app が iCloud から受け取った変更を DB に書いたら走らせる。書くものが無い同期は DB に触れないので自分で回り続けない。
       -wal は開いたまま追記されるので FSEvents が launchd に届かない。変更のたびに置き換えられる索引の状態ファイルで拾う -->
  <key>WatchPaths</key>
  <array>
    <string>@HOME@/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite</string>
    <string>@HOME@/Library/Group Containers/group.com.apple.notes/NotesIndexerState-Modern</string>
  </array>
  <!-- 編集中は書き換えが続くので、起動の間隔を最低 15 秒あける -->
  <key>ThrottleInterval</key><integer>15</integer>
  <!-- 裏方の処理として低い優先度で動かす (省電力側のコア、I/O も後回し) -->
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@HOME@/.local/state/notes-sync/launchd.out</string>
  <key>StandardErrorPath</key><string>@HOME@/.local/state/notes-sync/launchd.err</string>
</dict>
</plist>
