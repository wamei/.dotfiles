[user]
    name = wamei
    email = wamei.cho@gmail.com
[color]
    ui = auto
[alias]
    st = status
    co = checkout
    mylog = log --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
    graph = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
    today = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s' --since='18 hour ago'
[push]
    default = nothing
[core]
    excludesfile = ~/.gitignore
    # diff / log -p / show を delta で表示する (mise で導入)。magit は --no-pager で
    # git を呼ぶので影響しない。
    # 行番号は pager だけに付ける。[delta] に書くと --color-only でも効いてしまい、
    # 行の中身を崩す (magit-delta の stage と git add -p が壊れる)。
    pager = delta --line-numbers
[interactive]
    # git add -p の hunk 表示も delta で色付けする (--color-only は行を崩さない)。
    diffFilter = delta --color-only
[delta]
    # n / N で次 / 前のファイル・hunk へ移動する。
    navigate = true
[ghq]
    root = ~/projects
[filter "lfs"]
    process = git-lfs filter-process
    required = true
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
# マシン固有の設定 (仕事用の includeIf など、リポジトリに載せないもの)。無ければ黙って無視される。
# 最後に読むので、ここまでの設定を上書きできる。
[include]
    path = ~/.gitconfig.local
