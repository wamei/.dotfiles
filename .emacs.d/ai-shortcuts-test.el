;;; ai-shortcuts-test.el --- AI routing tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ai-shortcuts)
(require 'codex-grid)

(ert-deftest wamei/ai-target-prefers-selected-visible-then-project ()
  (save-window-excursion
    (delete-other-windows)
    (let ((editor (generate-new-buffer " ai-editor"))
          (codex (generate-new-buffer "*codex:/tmp/proj/:a*"))
          (claude (generate-new-buffer " ai-claude")))
      (unwind-protect
          (cl-letf (((symbol-function 'wamei/ai--backend)
                     (lambda (buffer) (cond ((eq buffer codex) 'codex)
                                            ((eq buffer claude) 'claude))))
                    ((symbol-function 'buffer-list) (lambda (&optional _) (list claude editor codex)))
                    ((symbol-function 'wamei/ai--root) (lambda () "/tmp/proj/"))
                    ((symbol-function 'wamei/ai--directory)
                     (lambda (buffer _) (if (eq buffer codex) "/tmp/proj/" "/tmp/other/"))))
            (switch-to-buffer editor)
            ;; 別プロジェクトの Claude が MRU でも同プロジェクトの Codex を使う。
            (should (equal (wamei/ai--target) (cons 'codex codex)))
            (set-window-buffer (split-window-right) claude)
            ;; 表示中のパネルを優先する。
            (should (equal (wamei/ai--target) (cons 'claude claude)))
            (switch-to-buffer codex)
            ;; MRU の Claude より選択中の Codex を優先する。
            (should (equal (wamei/ai--target) (cons 'codex codex)))
            (switch-to-buffer editor)
            (delete-other-windows)
            (cl-letf (((symbol-function 'wamei/ai--root) (lambda () "/tmp/unstarted/")))
              (should (equal (wamei/ai--target) '(claude)))))
        (mapc #'kill-buffer (list editor codex claude))))))

(ert-deftest wamei/ai-target-uses-most-recent-when-both-visible ()
  (save-window-excursion
    (delete-other-windows)
    (let ((editor (generate-new-buffer " ai-editor"))
          (codex (generate-new-buffer " ai-codex"))
          (claude (generate-new-buffer " ai-claude")))
      (unwind-protect
          (cl-letf (((symbol-function 'wamei/ai--backend)
                     (lambda (buffer) (cond ((eq buffer codex) 'codex)
                                            ((eq buffer claude) 'claude))))
                    ((symbol-function 'wamei/ai--root) (lambda () "/tmp/")))
            (switch-to-buffer editor)
            (set-window-buffer (split-window-right) codex)
            (set-window-buffer (split-window-below) claude)
            (cl-letf (((symbol-function 'buffer-list) (lambda (&optional _) (list editor codex claude))))
              (should (eq (car (wamei/ai--target)) 'codex)))
            (cl-letf (((symbol-function 'buffer-list) (lambda (&optional _) (list editor claude codex))))
              (should (eq (car (wamei/ai--target)) 'claude))))
        (mapc #'kill-buffer (list editor codex claude))))))

(ert-deftest wamei/ai-dispatch-preserves-origin-prefix-and-cycle-context ()
  (with-temp-buffer
    (let ((editor (current-buffer))
          (target (generate-new-buffer " ai-target"))
          called)
      (unwind-protect
          (cl-letf (((symbol-function 'wamei/ai--target) (lambda () (cons 'codex target)))
                    ((symbol-function 'wamei/codex-toggle)
                     (lambda (arg) (interactive "P") (setq called (list 'toggle arg (current-buffer)))))
                    ((symbol-function 'codex)
                     (lambda (arg) (interactive "P") (setq called (list 'start arg (current-buffer)))))
                    ((symbol-function 'wamei/codex-panel-next)
                     (lambda () (interactive) (setq called (list 'next (current-buffer)))))
                    ((symbol-function 'wamei/codex-panel-previous)
                     (lambda () (interactive) (setq called (list 'previous (current-buffer)))))
                    ((symbol-function 'wamei/codex-grid-tab)
                     (lambda (arg) (interactive "P") (setq called (list 'grid arg (current-buffer))))))
            (wamei/ai-toggle '(4))
            (should (equal called (list 'toggle '(4) editor)))
            (wamei/ai-start)
            (should (equal called (list 'start nil editor)))
            (wamei/ai-next)
            (should (equal called (list 'next target)))
            (wamei/ai-previous)
            (should (equal called (list 'previous target)))
            (wamei/ai-grid-tab '(4))
            (should (equal called (list 'grid '(4) editor)))
            (should (eq (current-buffer) editor)))
        (kill-buffer target)))))

(ert-deftest wamei/ai-unstarted-dispatches-to-claude ()
  (let (called)
    (cl-letf (((symbol-function 'wamei/ai--target) (lambda () '(claude)))
              ((symbol-function 'wamei/claude-toggle)
               (lambda () (interactive) (setq called 'toggle)))
              ((symbol-function 'claude-code-ide)
               (lambda () (interactive) (setq called 'start)))
              ((symbol-function 'wamei/claude-panel-next)
               (lambda () (interactive) (setq called 'next)))
              ((symbol-function 'wamei/claude-panel-previous)
               (lambda () (interactive) (setq called 'previous)))
              ((symbol-function 'wamei/claude-grid-tab)
               (lambda () (interactive) (setq called 'grid))))
      (wamei/ai-toggle) (should (eq called 'toggle))
      (wamei/ai-start) (should (eq called 'start))
      (wamei/ai-next) (should (eq called 'next))
      (wamei/ai-previous) (should (eq called 'previous))
      (wamei/ai-grid-tab) (should (eq called 'grid)))))

(ert-deftest wamei/ai-does-not-select-dead-codex-buffer ()
  (with-temp-buffer
    (rename-buffer "*codex:/tmp/:dead*" t)
    (should-not (wamei/ai--backend (current-buffer)))))

(ert-deftest wamei/codex-grid-builds-and-updates-without-claude-setup ()
  (save-window-excursion
    (delete-other-windows)
    (let ((first (generate-new-buffer "*codex:/tmp/:a*"))
          (second (generate-new-buffer "*codex:/tmp/:b*"))
          (buffers nil)
          (wamei/codex-panel--order nil)
          (wamei/claude-grid-min-window-width 20)
          (wamei/claude-grid-min-window-height 4)
          (tab-name "ordinary"))
      (setq buffers (list first second))
      (unwind-protect
          (cl-letf (((symbol-function 'codex--directory) (lambda () "/tmp/"))
                    ((symbol-function 'codex--find-codex-buffers-for-directory)
                     (lambda (directory) (should (equal directory "/tmp/")) buffers))
                    ((symbol-function 'codex--find-all-codex-buffers) (lambda () buffers))
                    ((symbol-function 'wamei/claude-grid--select-tab)
                     (lambda (name) (setq tab-name name)))
                    ((symbol-function 'tab-bar--current-tab-find)
                     (lambda () `((name . ,tab-name))))
                    ((symbol-function 'wamei/claude-panel--setup)
                     (lambda (_) (ert-fail "Codex must not use Claude buffer setup"))))
            (wamei/codex-grid-tab)
            (should (equal tab-name "Codex - tmp"))
            (should (= (length (window-list nil 'no-mini)) 2))
            (should (buffer-local-value 'wamei/codex-panel-keys-mode first))
            (should (get-buffer-window second))
            (should (eq (wamei/codex-panel--window) (selected-window)))
            (setq buffers (list first))
            (wamei/codex-grid--rearrange)
            (should (= (length (window-list nil 'no-mini)) 1))
            (should (eq (window-buffer (selected-window)) first))
            (wamei/codex-grid-tab '(4))
            (should (equal tab-name "Codex")))
        (mapc #'kill-buffer (list first second))))))

(provide 'ai-shortcuts-test)
