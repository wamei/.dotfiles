;;; codex-usage-test.el --- Usage integration tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'codex-usage)

(ert-deftest wamei/codex-usage-selects-codex-bucket-and-renders ()
  (let ((wamei/codex-usage--state nil)
        (wamei/codex-usage--updated-at nil)
        (wamei/codex-usage--error t)
        (wamei/codex-usage--cache nil)
        (wamei/claude-usage-use-images nil))
    (wamei/codex-usage--adopt
     '((rateLimits (primary (usedPercent . 99)))
       (rateLimitsByLimitId
        (codex (primary (usedPercent . 25) (windowDurationMins . 300)
                        (resetsAt . 1800000000))
               (secondary (usedPercent . 80) (windowDurationMins . 10080))))))
    (should-not wamei/codex-usage--error)
    (should wamei/codex-usage--updated-at)
    (should (= (plist-get (plist-get wamei/codex-usage--state :primary) :percent) 25))
    (should (equal (plist-get (plist-get wamei/codex-usage--state :primary) :resets-at)
                   (seconds-to-time 1800000000)))
    (let ((text (wamei/codex-usage-mode-line)))
      (should (string-match-p "5h" text))
      (should (string-match-p "25%%" text))
      (should (string-match-p "W" text))
      (should (string-match-p "80%%" text)))
    (wamei/codex-usage--adopt '((rateLimits (primary (usedPercent . 0)))))
    (should (= (plist-get (plist-get wamei/codex-usage--state :primary) :percent) 0))
    (should-not (plist-get wamei/codex-usage--state :secondary))))

(ert-deftest wamei/codex-usage-fragmented-rpc-and-error-retains-state ()
  (let* ((process (make-pipe-process :name "codex-usage-test" :noquery t))
         (wamei/codex-usage--process process)
         (wamei/codex-usage--state nil)
         (wamei/codex-usage--updated-at nil)
         (wamei/codex-usage--error nil)
         (wamei/codex-usage--cache nil)
         (wamei/codex-usage--timeout nil)
         sent)
    (unwind-protect
        (cl-letf (((symbol-function 'process-send-string)
                   (lambda (_process message)
                     (push (json-parse-string message :object-type 'alist) sent))))
          (wamei/codex-usage--filter process "{\"id\":1,\"result\":{}")
          (should-not sent)
          (wamei/codex-usage--filter process "}\n")
          (should (equal (mapcar (lambda (message) (alist-get 'method message))
                                (reverse sent))
                         '("initialized" "account/rateLimits/read")))
          (should (process-get process 'pending))
          (wamei/codex-usage--filter
           process "{\"id\":2,\"result\":{\"rateLimits\":{\"primary\":{\"usedPercent\":42},\"secondary\":null}}}\n")
          (should-not (process-get process 'pending))
          (should (= (plist-get (plist-get wamei/codex-usage--state :primary) :percent) 42))
          (wamei/codex-usage--filter process "{\"id\":2,\"error\":{\"message\":\"failed\"}}\n")
          (should wamei/codex-usage--error)
          (should-not (process-live-p process))
          (should (= (plist-get (plist-get wamei/codex-usage--state :primary) :percent) 42)))
      (when (process-live-p process) (delete-process process)))))

(ert-deftest wamei/codex-usage-restores-modeline-and-preserves-input-tag ()
  (with-temp-buffer
    (setq-local mode-line-format nil)
    (wamei/codex-usage--setup (current-buffer))
    (should (equal mode-line-format wamei/codex-usage--mode-line-format))
    (should (memq 'mode-line-process mode-line-format))))

(ert-deftest wamei/codex-usage-hidden-panel-stops-client ()
  (let* ((process (make-pipe-process :name "codex-usage-test" :noquery t))
         (wamei/codex-usage--process process)
         (wamei/codex-usage--timeout nil))
    (unwind-protect
        (cl-letf (((symbol-function 'wamei/codex-usage--visible-p) (lambda () nil)))
          (wamei/codex-usage--tick)
          (should-not (process-live-p process))
          (should-not wamei/codex-usage--process))
      (when (process-live-p process) (delete-process process)))))

(ert-deftest wamei/codex-usage-tick-refreshes-one-interval-after-update ()
  "前回の取得から 1 周期後の tick では取り直す。
応答は tick の少し後に届くので、次の tick では interval にわずかに届かない。
それを新しいとみなすと 1 回おきにしか取らなくなる。"
  (let ((wamei/codex-usage--updated-at (- (float-time) (- wamei/codex-usage-interval 0.6)))
        (wamei/codex-usage--error nil)
        (refreshes 0))
    (cl-letf (((symbol-function 'wamei/codex-usage--visible-p) (lambda () t))
              ((symbol-function 'wamei/codex-usage-refresh)
               (lambda () (cl-incf refreshes))))
      (wamei/codex-usage--tick)
      (should (equal refreshes 1)))))

(ert-deftest wamei/codex-usage-window-change-ticks-when-panel-appears ()
  "パネルが隠れていた状態から見えたら、次のタイマーを待たずに tick する。
Claude と共有のサイドパネルで切り替えると `wamei/codex-panel-show' を通らない。"
  (let ((wamei/codex-usage--was-visible nil)
        (visible nil)
        (ticks 0))
    (cl-letf (((symbol-function 'wamei/codex-usage--visible-p) (lambda () visible))
              ((symbol-function 'wamei/codex-usage--tick)
               (lambda () (cl-incf ticks))))
      (wamei/codex-usage--on-window-change nil)
      (should (equal ticks 0))
      (setq visible t)
      (wamei/codex-usage--on-window-change nil)
      (should (equal ticks 1))
      (wamei/codex-usage--on-window-change nil)
      (should (equal ticks 1))
      (setq visible nil)
      (wamei/codex-usage--on-window-change nil)
      (setq visible t)
      (wamei/codex-usage--on-window-change nil)
      (should (equal ticks 2)))))

(provide 'codex-usage-test)
