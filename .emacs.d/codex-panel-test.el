;;; codex-panel-test.el --- Codex panel tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'codex)
(require 'codex-panel)
(require 'codex-ghostel)
(require 'desktop-side-windows)

(ert-deftest wamei/codex-panel-survives-magit-fullframe-and-quit ()
  (require 'magit)
  (require 'magit-main-window)
  (save-window-excursion
    (delete-other-windows)
    (let ((editor (generate-new-buffer " codex-magit-editor"))
          (panel (generate-new-buffer "*codex:/tmp/:magit-test*"))
          (status (generate-new-buffer " codex-magit-status"))
          (magit-display-buffer-function #'magit-display-buffer-fullframe-status-v1)
          (magit-pre-display-buffer-hook '(wamei/magit-save-main-window)))
      (unwind-protect
          (progn
            (switch-to-buffer editor)
            (let* ((window (wamei/codex-panel-show panel))
                   (width (window-total-width window)))
              (with-current-buffer status
                (magit-status-mode)
                (magit-display-buffer status))
              (should (window-live-p window))
              (should (eq (window-buffer window) panel))
              (should (= (window-total-width window) width))
              (with-current-buffer status (wamei/magit-restore-main-window))
              (should (window-live-p window))
              (should (eq (window-buffer window) panel))
              (should (= (window-total-width window) width))
              (should (get-buffer-window editor))))
        (mapc #'kill-buffer (list editor panel status))))))

(ert-deftest wamei/codex-panel-restores-saved-project-and-width ()
  (save-window-excursion
    (delete-other-windows)
    (let ((buffer (generate-new-buffer "*codex:/tmp/:saved*"))
          (spec '(:buffer "*codex:/tmp/:saved*" :directory "/tmp/" :size 30))
          (wamei/codex-panel--order nil)
          (origin (selected-window))
          (starts 0)
          (wamei/desktop-side-restorers
           '(("\\`\\*codex:" . wamei/codex-panel-restore))))
      (unwind-protect
          (cl-letf (((symbol-function 'codex--buffer-process-live-p) (lambda (_) nil))
                    ((symbol-function 'wamei/project-tabs-current-root)
                     (lambda () "/wrong-project/"))
                    ((symbol-function 'codex--start-subcommand)
                     (lambda (command last extra instance)
                       (cl-incf starts)
                       (should (equal (codex--directory) "/tmp/"))
                       (should (equal command "resume"))
                       (should last)
                       (should-not extra)
                       (should (equal instance "saved"))
                       buffer)))
            (wamei/desktop-side-restore-specs (list spec))
            (should (= starts 1))
            (should (eq (selected-window) origin))
            (let ((window (wamei/codex-panel--window)))
              (should (eq (window-buffer window) buffer))
              (should (= (window-total-width window) 30)))
            (cl-letf (((symbol-function 'codex--buffer-process-live-p) (lambda (_) t)))
              (wamei/desktop-side-restore-specs (list spec))
              (should (= starts 1))))
        (kill-buffer buffer)))))

(ert-deftest wamei/codex-panel-title-follows-terminal-title ()
  (with-temp-buffer
    (rename-buffer "*codex:/tmp/:default*" t)
    (setq-local codex--buffer-instance-name "default")
    (setq-local ghostel-title nil)
    (setq-local ghostel-buffer-name-function nil)
    (should (equal (wamei/codex-panel--tab-name (current-buffer)) "default"))
    (let (refreshed)
      (unwind-protect
          (progn
            (advice-add 'ghostel--set-title :after #'wamei/codex-panel--title-updated)
            (cl-letf (((symbol-function 'force-mode-line-update)
                       (lambda (&optional all) (setq refreshed all))))
              (ghostel--set-title "  会話のタイトル  ")
              (should refreshed)
              (should (equal (wamei/codex-panel--tab-name (current-buffer)) "会話のタイトル"))
              (ghostel--set-title "更新後のタイトル")
              (should (equal (wamei/codex-panel--tab-name (current-buffer)) "更新後のタイトル"))
              (ghostel--set-title " ")
              (should (equal (wamei/codex-panel--tab-name (current-buffer)) "default"))))
        (advice-remove 'ghostel--set-title #'wamei/codex-panel--title-updated)))))

(ert-deftest wamei/codex-keys-work-in-ghostel-semi-char-mode ()
  (save-window-excursion
    (let ((original-map (current-global-map))
          (map (copy-keymap (current-global-map)))
          (ghostel-keymap-exceptions
           (append '("C-q" "C-<tab>" "C-S-<tab>") ghostel-keymap-exceptions))
          (ghostel-semi-char-mode-map (copy-keymap ghostel-semi-char-mode-map)))
      (define-key map (kbd "C-q") nil)
      (define-key map (kbd "C-q a x") #'wamei/codex-toggle)
      (unwind-protect
          (progn
            (use-global-map map)
            (ghostel--rebuild-semi-char-keymap)
            (with-temp-buffer
              (ghostel-mode)
              (codex--term-configure 'ghostel)
              (codex--term-setup-keymap 'ghostel)
              (codex--term-post-start 'ghostel)
              (wamei/codex-panel-show (current-buffer))
              (should (eq (key-binding (kbd "C-q a x")) #'wamei/codex-toggle))
              (should (eq (key-binding (kbd "C-c x")) #'codex-transient))
              (should (eq (key-binding (kbd "s-v")) #'wamei/term-input-paste))
              (should (eq (key-binding (kbd "<C-tab>")) #'wamei/codex-panel-next))
              (should (eq (key-binding (kbd "<S-return>")) #'codex--terminal-insert-newline))
              (codex--term-read-only-mode 'ghostel)
              (should (codex--term-in-read-only-p 'ghostel))
              (codex--term-interactive-mode 'ghostel)
              (should-not (codex--term-in-read-only-p 'ghostel))
              (should (eq (key-binding (kbd "<S-return>")) #'codex--terminal-insert-newline))))
        (use-global-map original-map)))))

(ert-deftest wamei/codex-ghostel-sends-encoded-actions-and-pastes ()
  (let (events paste scheduled)
    (cl-letf (((symbol-function 'ghostel-send-key)
               (lambda (key &optional mods) (push (list key mods) events)))
              ((symbol-function 'ghostel-paste-string)
               (lambda (text) (setq paste text)))
              ((symbol-function 'codex--schedule-submit-returns)
               (lambda (text &rest _) (setq scheduled text))))
      (codex--term-send-action 'ghostel :return)
      (codex--term-send-action 'ghostel :newline)
      (codex--term-send-action 'ghostel :previous-agent)
      (should (equal (reverse events) '(("return" nil) ("j" "ctrl") ("left" "alt"))))
      (codex--term-submit-command 'ghostel "日本語\n複数行")
      (should (equal paste "日本語\n複数行"))
      (should (equal scheduled paste)))))

(ert-deftest wamei/codex-ghostel-emacs-motion-keys-send-arrows ()
  "入力中は C-p/C-n/C-f/C-b を矢印キーとして送る。copy mode では Emacs の移動に戻す。
Codex の選択式の質問は選択肢の移動が矢印キーだけで、Ctrl+P/N は質問の切り替えに
固定されている。"
  (let (events)
    (cl-letf (((symbol-function 'ghostel-send-key)
               (lambda (key &optional mods) (push (list key mods) events))))
      (with-temp-buffer
        (ghostel-mode)
        (codex--term-configure 'ghostel)
        (codex--term-setup-keymap 'ghostel)
        (codex--term-post-start 'ghostel)
        (dolist (key '("C-p" "C-n" "C-f" "C-b"))
          (call-interactively (key-binding (kbd key))))
        (should (equal (reverse events)
                       '(("up" nil) ("down" nil) ("right" nil) ("left" nil))))
        (codex--term-read-only-mode 'ghostel)
        (setq events nil)
        (should-not (memq (key-binding (kbd "C-n"))
                          '(ghostel--send-event wamei/codex-ghostel-down)))
        (codex--term-interactive-mode 'ghostel)
        (call-interactively (key-binding (kbd "C-n")))
        (should (equal events '(("down" nil))))))))

(ert-deftest wamei/codex-directory-respects-tab-and-session ()
  (cl-letf (((symbol-function 'wamei/project-tabs-current-root) (lambda () "/tmp/tab/")))
    (with-temp-buffer
      (should (equal (wamei/codex--directory (lambda () "/tmp/fallback/")) "/tmp/tab/")))
    (with-temp-buffer
      (rename-buffer "*codex:/tmp/session/*" t)
      (setq-local codex--buffer-directory "/tmp/session/")
      (should (equal (wamei/codex--directory (lambda () "/tmp/fallback/"))
                     "/tmp/session/")))))

(ert-deftest wamei/codex-panel-reuses-window-and-restores-focus ()
  (save-window-excursion
    (delete-other-windows)
    (let ((first (generate-new-buffer "*codex:/tmp/:first*"))
          (second (generate-new-buffer "*codex:/tmp/:second*"))
          (wamei/codex-panel--order nil)
          (wamei/codex--previous-window nil)
          (wamei/codex--previous-buffer nil)
          (origin (selected-window)))
      (unwind-protect
          (cl-letf (((symbol-function 'codex--find-codex-buffers-for-directory)
                     (lambda (_) (list first second))))
            (wamei/codex-toggle)
            (let ((panel (selected-window)))
              (should (eq (window-parameter panel 'window-side) 'right))
              (should (window-parameter panel 'no-other-window))
              (with-current-buffer first
                (wamei/codex-panel-next))
              (should (eq panel (wamei/codex-panel--window)))
              (should (eq (window-buffer panel) second))
              (wamei/codex-toggle)
              (should (eq (selected-window) origin))
              (wamei/codex-toggle)
              (should (eq (selected-window) panel))
              (wamei/codex-toggle t)
              (should-not (window-live-p panel))
              (should (buffer-live-p second))))
        (kill-buffer first)
        (kill-buffer second)))))

(ert-deftest wamei/codex-toggle-starts-only-without-project-session ()
  (save-window-excursion
    (delete-other-windows)
    (let ((buffer (generate-new-buffer "*codex:/tmp/:new*"))
          (starts 0)
          (wamei/codex-panel--order nil))
      (unwind-protect
          (cl-letf (((symbol-function 'codex--find-codex-buffers-for-directory)
                     (lambda (_) nil))
                    ((symbol-function 'codex--start-subcommand)
                     (lambda (subcommand last-flag &rest _)
                       (should (equal subcommand "resume"))
                       (should last-flag)
                       (cl-incf starts)
                       buffer)))
            (wamei/codex-toggle)
            (should (= starts 1))
            (should (eq (window-buffer (selected-window)) buffer)))
        (kill-buffer buffer)))))

