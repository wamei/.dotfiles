;;; desktop-background.el --- Keep desktop disk I/O out of redisplay -*- lexical-binding: t; -*-
;;; Code:
(require 'desktop)
(require 'cl-lib)
(require 'seq)
(require 'wamei-background
         (expand-file-name "background-job" (file-name-directory (or load-file-name buffer-file-name))))

(defconst wamei/desktop-background--source
  (or load-file-name buffer-file-name))
(defvar wamei/desktop-background--snapshotting nil)
(defvar wamei/desktop-background-last-error nil)
(defvar wamei/desktop-background--contents nil)
(defvar wamei/desktop-background--fake-time nil)
(defvar wamei/desktop-background--scrollbacks nil)
(defvar wamei/desktop-background--generation 0)
(defvar wamei/desktop-background--scrollback-history (make-hash-table :test 'equal))
(defvar wamei/desktop-background--unacknowledged nil
  "Hashes of contents sent to children whose commit was not yet acknowledged.
A child can commit and then lose its result (timeout after sleep, cancel by
a manual save).  The file then no longer matches `desktop-file-modtime'
although this Emacs wrote it, so such contents are accepted as our own.")

(defun wamei/desktop-background--hash (contents)
  "Hash CONTENTS as the bytes written to the desktop file."
  (secure-hash 'md5 (encode-coding-string contents 'utf-8-emacs)))

(defun wamei/desktop-background--file-hash (file)
  "Hash FILE's bytes, or nil if it cannot be read."
  (ignore-errors
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally file)
      (secure-hash 'md5 (current-buffer)))))

(defun wamei/desktop-background--collect-scrollback (file text)
  "Capture scrollback generated by the existing desktop save hook."
  (push (cons file text) wamei/desktop-background--scrollbacks)
  t)

(defun wamei/desktop-background--file-handler (operation &rest args)
  "Capture desktop serialization without replacing native Emacs primitives."
  (pcase operation
    ('file-attributes (list nil 1 nil nil nil wamei/desktop-background--fake-time))
    ('write-region
     (setq wamei/desktop-background--contents
           (if (stringp (car args)) (car args)
             (buffer-substring-no-properties (nth 0 args) (nth 1 args))))
     nil)
    (_ (let ((inhibit-file-name-handlers
              (cons #'wamei/desktop-background--file-handler
                    (and (eq inhibit-file-name-operation operation)
                         inhibit-file-name-handlers)))
             (inhibit-file-name-operation operation))
         (apply operation args)))))

(defun wamei/desktop-background--write (file lock owner expected contents
                                              &optional scrollbacks adoptable)
  "Atomically write CONTENTS to FILE if LOCK and EXPECTED still match.
FILE also counts as unchanged when its hash is in ADOPTABLE.
Runs in the child.  A failed write leaves the previous desktop intact."
  (cl-labels ((check ()
               (unless (and (equal owner
                                   (with-temp-buffer
                                     (insert-file-contents lock)
                                     (string-to-number (buffer-string))))
                            (or (equal expected
                                       (file-attribute-modification-time (file-attributes file)))
                                (member (wamei/desktop-background--file-hash file) adoptable)))
                 (error "Desktop changed or lock ownership lost"))))
    (check)
    (dolist (entry scrollbacks)
      (make-directory (file-name-directory (car entry)) t)
      (let ((coding-system-for-write 'utf-8-unix))
        (write-region (cdr entry) nil (car entry) nil 'silent)))
    (let ((temp (make-temp-file (expand-file-name ".desktop-save-" (file-name-directory file)))))
      (unwind-protect
          (progn
            (let ((coding-system-for-write 'utf-8-emacs))
              (write-region contents nil temp nil 'silent))
            (check)
            (rename-file temp file t)
            (file-attribute-modification-time (file-attributes file)))
        (when (file-exists-p temp) (delete-file temp))))))

(defun wamei/desktop-background--snapshot ()
  "Serialize the desktop using desktop.el, without opening its target file.
The child checks the real lock and modification time before committing."
  (let* ((file (desktop-full-file-name))
         (fake-time (or desktop-file-modtime (current-time)))
         (desktop-file-modtime fake-time)
         (desktop-file-checksum desktop-file-checksum)
         (wamei/desktop-background--snapshotting t)
         (scrollback-name (and (fboundp 'wamei/term-restore--scrollback-file)
                               (symbol-function 'wamei/term-restore--scrollback-file)))
         (generation (format "%s-%s-%s" (emacs-pid)
                             (format-time-string "%s%N")
                             (cl-incf wamei/desktop-background--generation)))
         (wamei/desktop-background--contents nil)
         (wamei/desktop-background--scrollbacks nil)
         (wamei/desktop-background--fake-time fake-time)
         (file-name-handler-alist
          (cons (cons (concat "\\`" (regexp-quote file) "\\'")
                      #'wamei/desktop-background--file-handler)
                file-name-handler-alist)))
    (cl-letf (((symbol-function 'desktop-owner) (lambda (&rest _) (emacs-pid)))
              ((symbol-function 'desktop--get-file-modtime) #'ignore)
              ((symbol-function 'wamei/term-restore--write-scrollback)
               #'wamei/desktop-background--collect-scrollback)
              ((symbol-function 'wamei/term-restore--scrollback-file)
               (lambda (&rest args)
                 ;; A failed/cancelled snapshot must not change scrollbacks
                 ;; referenced by the previous desktop file.
                 (concat (apply scrollback-name args) "." generation)))
              ;; Pruning on exit/manual save remains unchanged.  It is not
              ;; necessary to delete files during a background snapshot.
              ((symbol-function 'wamei/term-restore--prune) #'ignore)
              ((symbol-function 'wamei/term-restore--prune-closed) #'ignore))
      (desktop-save desktop-dirname nil t))
    (when wamei/desktop-background--contents
      (list wamei/desktop-background--contents desktop-file-checksum
            wamei/desktop-background--scrollbacks))))

(defun wamei/desktop-background--auto-save (_original)
  "Serialize on the UI thread; perform lock checks and disk I/O in a child."
  (when (and desktop-save-mode desktop-dirname
             (integerp desktop-auto-save-timeout) (> desktop-auto-save-timeout 0)
             (not desktop-lazy-timer)
             (not (wamei/background-running-p 'desktop-save)))
    (when-let* ((snapshot (wamei/desktop-background--snapshot)))
      (let ((directory desktop-dirname)
            (base desktop-base-file-name)
            (file (desktop-full-file-name))
            (lock (desktop-full-lock-name))
            (expected desktop-file-modtime))
        (push (wamei/desktop-background--hash (car snapshot))
              wamei/desktop-background--unacknowledged)
        (setq wamei/desktop-background--unacknowledged
              (seq-take wamei/desktop-background--unacknowledged 8))
        (wamei/background-start
         'desktop-save
         `(progn
            (package-initialize)
            (load ,wamei/desktop-background--source nil t)
            (wamei/desktop-background--write ,file ,lock ,(emacs-pid)
                                             ',expected ,(car snapshot) ',(nth 2 snapshot)
                                             ',wamei/desktop-background--unacknowledged))
         (lambda (result)
           (when (and (equal directory desktop-dirname)
                      (equal base desktop-base-file-name))
             (if (eq (car result) :ok)
                 (progn
                   (setq desktop-file-modtime (cadr result)
                         desktop-file-checksum (cadr snapshot)
                         wamei/desktop-background--unacknowledged nil
                         wamei/desktop-background-last-error nil)
                   ;; Cleanup cannot delay acknowledgement of the committed
                   ;; desktop.  Only delete explicitly superseded paths, never
                   ;; a directory scan that could include a newer in-flight save.
                   (let ((previous (gethash file wamei/desktop-background--scrollback-history)))
                     (puthash file (mapcar #'car (nth 2 snapshot))
                              wamei/desktop-background--scrollback-history)
                     (when previous
                       (wamei/background-start
                        (cons 'desktop-prune file)
                        `(dolist (old ',previous)
                           (when (file-exists-p old) (delete-file old)))
                        #'ignore))))
               (setq wamei/desktop-background-last-error (cadr result))
               (message "Background desktop save failed; previous desktop retained")))))))))

(defun wamei/desktop-background--manual-save (original &rest args)
  "Prevent a pending background save from overwriting a manual/exit save."
  (unless wamei/desktop-background--snapshotting
    (wamei/background-cancel 'desktop-save)
    ;; A cancelled or timed-out child may already have committed.  Adopt
    ;; that file so `desktop-save' does not ask whether to overwrite it.
    (when wamei/desktop-background--unacknowledged
      (let* ((file (desktop-full-file-name))
             (modtime (file-attribute-modification-time (file-attributes file))))
        (when (and modtime (not (equal modtime desktop-file-modtime))
                   (member (wamei/desktop-background--file-hash file)
                           wamei/desktop-background--unacknowledged))
          (setq desktop-file-modtime modtime)))
      (setq wamei/desktop-background--unacknowledged nil)))
  (apply original args))

(defun wamei/desktop-background-enable ()
  "Keep session auto-save enabled without synchronous target-file I/O."
  (advice-add 'desktop-auto-save :around #'wamei/desktop-background--auto-save)
  (advice-add 'desktop-save :around #'wamei/desktop-background--manual-save))

(provide 'desktop-background)
;;; desktop-background.el ends here
