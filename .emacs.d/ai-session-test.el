;;; ai-session-test.el --- 会話単位の保存・復元テスト -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ai-panel-test)
(require 'ai-session)

(defun wamei/ai-session-test--id (index)
  (format "%08x-0000-0000-0000-%012x" index index))

(ert-deftest wamei/ai-session-reads-claude-id-for-exact-native-pid ()
  (wamei/ai-panel-test--with-env
    (let* ((root (make-temp-file "ai-session-metadata" t))
           (process-environment (cons (concat "CLAUDE_CONFIG_DIR=" root) process-environment))
           (buffer (wamei/ai-panel-test--claude "/tmp/"))
           (id (wamei/ai-session-test--id 1)))
      (unwind-protect
          (progn
            (make-directory (expand-file-name "sessions" root))
            (with-current-buffer buffer (setq-local ghostel--pid 1234))
            (with-temp-file (expand-file-name "sessions/1234.json" root)
              (insert (json-encode `((pid . 1234) (sessionId . ,id) (cwd . "/tmp/")))))
            ;; より新しい別プロセスの会話は使わない。
            (with-temp-file (expand-file-name "sessions/5678.json" root)
              (insert (json-encode `((pid . 5678) (sessionId . ,(wamei/ai-session-test--id 2)) (cwd . "/tmp/")))))
            (should (equal (wamei/ai-session-id buffer 'claude) id))
            (with-current-buffer buffer (setq-local wamei/ai-session--id nil))
            (with-temp-file (expand-file-name "sessions/1234.json" root)
              (insert (json-encode `((pid . 1234) (sessionId . ,id) (cwd . "/wrong-project/")))))
            (should-not (wamei/ai-session-id buffer 'claude)))
        (delete-directory root t)))))

(ert-deftest wamei/ai-session-saves-every-open-conversation-and-excludes-closed ()
  (wamei/ai-panel-test--with-env
    (let* ((claude-a (wamei/ai-panel-test--claude "/tmp/" "a"))
           (claude-b (wamei/ai-panel-test--claude "/tmp/" "b"))
           (codex-a (wamei/ai-panel-test--codex "/tmp/" "a"))
           (codex-b (wamei/ai-panel-test--codex "/tmp/" "b"))
           (closed (wamei/ai-panel-test--codex "/tmp/" "closed"))
           (unknown (wamei/ai-panel-test--codex "/tmp/" "unknown"))
           (wamei/ai-session-saved nil))
      (dolist (buffer (list claude-a claude-b))
        (make-pipe-process :name "ai-session-test" :buffer buffer :noquery t))
      (cl-loop for buffer in (list claude-a claude-b codex-a codex-b closed)
               for index from 1 do
               (with-current-buffer buffer
                 (if (wamei/ai--backend buffer)
                     (setq-local wamei/ai-session--id (wamei/ai-session-test--id index)))
                 (when (codex--buffer-p buffer)
                   (setq-local codex--session-id (wamei/ai-session-test--id index)))))
      (delete-process (get-buffer-process closed))
      (wamei/ai-panel-show claude-a)
      (wamei/ai-panel-show codex-a)
      (wamei/ai-session-save)
      (should (= (length wamei/ai-session-saved) 4))
      (should (= (length (seq-filter (lambda (entry) (eq (plist-get entry :backend) 'claude))
                                    wamei/ai-session-saved)) 2))
      (should-not (seq-find (lambda (entry) (member (plist-get entry :buffer)
                                                   (list (buffer-name closed) (buffer-name unknown))))
                            wamei/ai-session-saved)))))

(ert-deftest wamei/ai-session-codex-restores-exact-id-without-latest ()
  (let* ((id (wamei/ai-session-test--id 3))
         (buffer (generate-new-buffer " ai-session-restored")))
    (unwind-protect
        (cl-letf (((symbol-function 'codex--start-session-buffer)
                   (lambda (directory backend instance switches resume-id prompt switch-after)
                     (should (equal directory "/tmp/"))
                     (should (eq backend 'ghostel))
                     (should (equal instance "named"))
                     (should-not switches)
                     (should (equal resume-id id))
                     (should-not prompt)
                     (should-not switch-after)
                     buffer)))
          (should (eq (wamei/ai-session--start
                       (list :backend 'codex :session-id id :directory "/tmp/" :instance "named")) buffer))
          (should (equal (buffer-local-value 'codex--session-id buffer) id)))
      (kill-buffer buffer))))

(ert-deftest wamei/ai-session-claude-restores-exact-id-without-picker-or-continue ()
  (wamei/ai-panel-test--with-env
    (let ((id (wamei/ai-session-test--id 4))
          (claude-code-ide-cli-extra-flags "--model opus")
          restored)
      (cl-letf (((symbol-function 'claude-code-ide--start-session)
                 (lambda (continue resume)
                   (should-not continue)
                   (should-not resume)
                   (should (equal (claude-code-ide--get-working-directory) "/tmp/"))
                   (should (equal (claude-code-ide--read-instance-name "/tmp/") "saved"))
                   (should (string-match-p (regexp-quote (concat "--resume " id)) claude-code-ide-cli-extra-flags))
                   (should (string-match-p "--model opus" claude-code-ide-cli-extra-flags))
                   (setq restored (wamei/ai-panel-test--claude "/tmp/" "saved")))))
        (should (eq (wamei/ai-session--start
                     (list :backend 'claude :session-id id :directory "/tmp/" :instance "saved")) restored))))))

(ert-deftest wamei/ai-session-restores-all-once-without-showing-hidden-panels ()
  (wamei/ai-panel-test--with-env
    (let ((wamei/ai-session-saved
           (cl-loop for index from 1 to 4 collect
                    (list :backend (if (< index 3) 'claude 'codex)
                          :session-id (wamei/ai-session-test--id index)
                          :directory "/tmp/" :buffer (if (< index 3)
                                                       (format "*claude-code[saved:%d]*" index)
                                                     (format "*codex:/tmp/:%d*" index))
                          :instance (format "%d" index))))
          (wamei/ai-session--restored (make-hash-table :test 'equal))
          (wamei/ai-session--names (make-hash-table :test 'equal))
          (starts 0))
      (cl-letf (((symbol-function 'wamei/ai-session--start)
                 (lambda (entry)
                   (should wamei/ai-session--restoring)
                   (cl-incf starts)
                   (let ((buffer (if (eq (plist-get entry :backend) 'claude)
                                     (wamei/ai-panel-test--claude "/tmp/" (plist-get entry :instance))
                                   (wamei/ai-panel-test--codex "/tmp/" (plist-get entry :instance)))))
                     (with-current-buffer buffer
                       (when (codex--buffer-p buffer) (setq-local codex--session-id (plist-get entry :session-id))))
                     buffer))))
        (wamei/ai-session-restore-all)
        (should (= starts 4))
        (should (= (length (window-list nil 'no-mini)) 1))
        (wamei/ai-session-restore-all)
        (should (= starts 4))
        (wamei/ai-session-restore-panel '(:buffer "*codex:/tmp/:3*" :size 30))
        (should (= starts 4))
        (should (equal (buffer-name (window-buffer (wamei/ai-panel--window t))) "*codex:/tmp/:3*"))
        ;; 復元後に終了した会話は、別のパネルの復元で生き返らせない。
        (let ((closed (gethash "*codex:/tmp/:4*" wamei/ai-session--names)))
          (delete-process (get-buffer-process closed)))
        (wamei/ai-session-restore-all)
        (should (= starts 4))))))

(ert-deftest wamei/ai-session-old-spec-without-id-does-not-open-latest ()
  (let ((wamei/ai-session-saved nil)
        (wamei/ai-session--names (make-hash-table :test 'equal)))
    (cl-letf (((symbol-function 'wamei/ai-session--start)
               (lambda (_) (ert-fail "Must not infer a latest conversation")))
              ((symbol-function 'wamei/ai-panel--schedule-grid) #'ignore))
      (should-not (wamei/ai-session-restore-panel '(:buffer "*codex:/tmp/:old*" :size 30))))))

(ert-deftest wamei/ai-session-codex-footer-saves-id-without-hooks ()
  (wamei/ai-panel-test--with-env
    (let* ((buffer (wamei/ai-panel-test--codex "/tmp/" "no-hooks"))
           (first (wamei/ai-session-test--id 10))
           (second (wamei/ai-session-test--id 11))
           (wamei/ai-session-saved nil))
      (with-current-buffer buffer
        (setq-local codex--session-id nil)
        (insert "Assistant mentioned " (wamei/ai-session-test--id 99) "\n")
        (dotimes (_ 15) (insert "Body text\n"))
        (insert first " · gpt-6 · 80% context left\n")
        (should (equal (wamei/ai-session-id buffer 'codex) first))
        (wamei/ai-session--capture-codex-id)
        (should (equal codex--session-id first)))
      (wamei/ai-session-save)
      (should (= (length wamei/ai-session-saved) 1))
      (should (equal (plist-get (car wamei/ai-session-saved) :session-id) first))
      ;; /resume や /new で切り替わった場合、古い hook の ID より footer を優先する。
      (with-current-buffer buffer
        (erase-buffer)
        (insert second " · gpt-6 · 90% context left\n")
        (should (equal (wamei/ai-session-id buffer 'codex) second))
        (wamei/ai-session--capture-codex-id)
        (erase-buffer)
        ;; 隠れたタブでは最後に描画して取得した ID を使う。
        (should (equal (wamei/ai-session-id buffer 'codex) second)))
      (wamei/ai-session-save)
      (should (equal (plist-get (car wamei/ai-session-saved) :session-id) second)))))

(ert-deftest wamei/ai-session-codex-does-not-use-body-or-old-scrollback-uuid ()
  (wamei/ai-panel-test--with-env
    (with-current-buffer (wamei/ai-panel-test--codex "/tmp/" "body")
      (setq-local codex--session-id nil)
      (insert (wamei/ai-session-test--id 10) " · gpt-6\n")
      (dotimes (_ 15) (insert "Body text\n"))
      (insert "Resume " (wamei/ai-session-test--id 99) " in a shell\n")
      (should-not (wamei/ai-session-id (current-buffer) 'codex)))))

(provide 'ai-session-test)
